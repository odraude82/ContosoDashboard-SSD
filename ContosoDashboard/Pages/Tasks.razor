@page "/tasks"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject ITaskService TaskService
@inject DocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>My Tasks - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>My Tasks</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateTaskModal">
                <i class="bi bi-plus-circle"></i> New Task
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-md-3">
            <label>Status</label>
            <select class="form-select" @bind="filterStatus">
                <option value="">All</option>
                <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                <option value="@Models.TaskStatus.InProgress">In Progress</option>
                <option value="@Models.TaskStatus.Completed">Completed</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>Priority</label>
            <select class="form-select" @bind="filterPriority">
                <option value="">All</option>
                <option value="@TaskPriority.Low">Low</option>
                <option value="@TaskPriority.Medium">Medium</option>
                <option value="@TaskPriority.High">High</option>
                <option value="@TaskPriority.Critical">Critical</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>&nbsp;</label>
            <button class="btn btn-secondary d-block w-100" @onclick="ApplyFilters">
                Apply Filters
            </button>
        </div>
    </div>

    <!-- Tasks List -->
    @if (tasks == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!tasks.Any())
    {
        <div class="alert alert-info">No tasks found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Due Date</th>
                        <th>Project</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr>
                            <td>
                                <strong>@task.Title</strong>
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <br />
                                    <small class="text-muted">@task.Description</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@GetPriorityColor(task.Priority)">
                                    @task.Priority
                                </span>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" 
                                        value="@task.Status" 
                                        @onchange="@(e => UpdateTaskStatus(task.TaskId, Enum.Parse<Models.TaskStatus>(e.Value?.ToString() ?? "NotStarted")))">
                                    <option value="@Models.TaskStatus.NotStarted">Not Started</option>
                                    <option value="@Models.TaskStatus.InProgress">In Progress</option>
                                    <option value="@Models.TaskStatus.Completed">Completed</option>
                                </select>
                            </td>
                            <td>
                                @if (task.DueDate.HasValue)
                                {
                                    var isOverdue = task.DueDate.Value < DateTime.UtcNow && task.Status != Models.TaskStatus.Completed;
                                    <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                        @task.DueDate.Value.ToString("MMM dd, yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No due date</span>
                                }
                            </td>
                            <td>
                                @if (task.Project != null)
                                {
                                    <a href="/projects/@task.ProjectId">@task.Project.Name</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewTaskDetails(task.TaskId)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (selectedTask is not null)
    {
        <section class="mt-4" aria-labelledby="task-documents-heading">
            <div class="d-flex align-items-start justify-content-between gap-3">
                <h2 id="task-documents-heading" class="h4">Documents for @selectedTask.Title</h2>
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CloseTaskDocuments">Close</button>
            </div>
            @if (taskDocuments.Count == 0)
            {
                <p class="text-muted">No documents are attached to this task.</p>
            }
            else
            {
                <ul class="list-unstyled">
                    @foreach (var document in taskDocuments)
                    {
                        <li><a href="/documents/@document.DocumentId/preview">@document.Title</a> <span class="text-muted">@document.Category</span></li>
                    }
                </ul>
            }
            <div class="row g-3 align-items-end mt-2">
                <div class="col-md-6">
                    <label class="form-label" for="attach-existing-document">Attach an available document</label>
                    <select id="attach-existing-document" class="form-select" @bind="selectedDocumentId">
                        <option value="">Select a document</option>
                        @foreach (var document in availableDocuments)
                        {
                            <option value="@document.DocumentId">@document.Title</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-primary w-100" type="button" @onclick="AttachSelectedDocumentAsync" disabled="@(!selectedDocumentId.HasValue)">Attach</button>
                </div>
            </div>
            <div class="row g-3 align-items-end mt-2">
                <div class="col-md-4">
                    <label class="form-label" for="task-document-title">Upload title</label>
                    <input id="task-document-title" class="form-control" maxlength="255" @bind="taskDocumentTitle" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="task-document-file">Upload to task</label>
                    <InputFile id="task-document-file" OnChange="OnTaskFileSelected" accept=".pdf,.docx,.xlsx,.pptx,.txt,.jpg,.jpeg,.png" class="form-control" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary w-100" type="button" @onclick="UploadTaskFileAsync" disabled="@(taskFile is null)">Upload and attach</button>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private List<TaskItem>? tasks;
    private string filterStatus = "";
    private string filterPriority = "";
    private int currentUserId = 0;
    private TaskItem? selectedTask;
    private IReadOnlyList<DocumentListItem> taskDocuments = [];
    private IReadOnlyList<DocumentListItem> availableDocuments = [];
    private int? selectedDocumentId;
    private string taskDocumentTitle = string.Empty;
    private IBrowserFile? taskFile;

    protected override async Task OnInitializedAsync()
    {
        // Get current user ID from authentication claims
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            await LoadTasks();
        }
    }

    private async Task LoadTasks()
    {
        tasks = await TaskService.GetUserTasksAsync(currentUserId);
    }

    private async Task ApplyFilters()
    {
        Models.TaskStatus? status = string.IsNullOrEmpty(filterStatus) ? null : Enum.Parse<Models.TaskStatus>(filterStatus);
        TaskPriority? priority = string.IsNullOrEmpty(filterPriority) ? null : Enum.Parse<TaskPriority>(filterPriority);

        tasks = await TaskService.GetFilteredTasksAsync(currentUserId, status, priority, null);
    }

    private async Task UpdateTaskStatus(int taskId, Models.TaskStatus newStatus)
    {
        if (currentUserId > 0)
        {
            await TaskService.UpdateTaskStatusAsync(taskId, currentUserId, newStatus);
            await LoadTasks();
        }
    }

    private void ShowCreateTaskModal()
    {
        // TODO: Implement modal dialog for creating tasks
    }

    private async Task ViewTaskDetails(int taskId)
    {
        selectedTask = await TaskService.GetTaskByIdAsync(taskId, currentUserId);
        if (selectedTask is null)
        {
            return;
        }

        taskDocuments = await DocumentService.GetTaskDocumentsAsync(taskId, currentUserId);
        availableDocuments = await DocumentService.SearchDocumentsAsync(currentUserId, new DocumentQuery());
        selectedDocumentId = null;
        taskFile = null;
        taskDocumentTitle = selectedTask.Title;
    }

    private void CloseTaskDocuments()
    {
        selectedTask = null;
        taskDocuments = [];
        taskFile = null;
    }

    private async Task AttachSelectedDocumentAsync()
    {
        if (selectedTask is null || selectedDocumentId is not int documentId)
        {
            return;
        }

        await DocumentService.LinkDocumentToTaskAsync(documentId, selectedTask.TaskId, currentUserId);
        taskDocuments = await DocumentService.GetTaskDocumentsAsync(selectedTask.TaskId, currentUserId);
        selectedDocumentId = null;
    }

    private void OnTaskFileSelected(InputFileChangeEventArgs args) => taskFile = args.File;

    private async Task UploadTaskFileAsync()
    {
        if (selectedTask is null || taskFile is null)
        {
            return;
        }

        await using var stream = taskFile.OpenReadStream(25 * 1024 * 1024);
        var request = new DocumentUploadRequest(
            taskFile.Name,
            taskDocumentTitle,
            null,
            "Project Documents",
            selectedTask.ProjectId,
            [],
            stream,
            taskFile.Size,
            selectedTask.TaskId);
        await DocumentService.UploadAsync(currentUserId, [request]);
        taskDocuments = await DocumentService.GetTaskDocumentsAsync(selectedTask.TaskId, currentUserId);
        availableDocuments = await DocumentService.SearchDocumentsAsync(currentUserId, new DocumentQuery());
        taskFile = null;
    }

    private string GetPriorityColor(TaskPriority priority)
    {
        return priority switch
        {
            TaskPriority.Critical => "danger",
            TaskPriority.High => "warning",
            TaskPriority.Medium => "info",
            TaskPriority.Low => "secondary",
            _ => "secondary"
        };
    }
}
